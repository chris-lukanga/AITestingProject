# The complete local demo works without this file. No endpoint required.
# Optional: copy to .env and add ONE key for the live student assistant.
GEMINI_API_KEY=
# Alternative provider (leave blank if using Gemini):
OPENROUTER_API_KEY=
OPENROUTER_ONLY_FREE=true

# Optional fallback providers. Free models only; no URLs needed.
# Groq is different from xAI's Grok. Keep the Groq account on its Free plan.
GROQ_API_KEY=
XKIRO_API_KEY=

# Optional web research for live test planning. Bundled references work without it.
TAVILY_API_KEY=

# Advanced settings and remote application testing: see docs/API.md.
